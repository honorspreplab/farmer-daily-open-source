# Local/server-only settings. Never include this file or the real .env in a static build.
# Copy the template only when setting up a NEW local environment; do not overwrite an existing key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
# Disabled by default. A key alone never enables paid calls.
AI_ENABLED=false
AI_DAILY_BUDGET_USD=0

# Server-only identities; blank grants no administrator privileges.
ADMIN_EMAILS=
APP_ORIGIN=

# No outgoing messages or automatic scheduling by default.
MESSAGING_ENABLED=false
MESSAGING_SCHEDULER_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_CONTENT_SID=
MESSAGING_DATA_KEY=
MESSAGING_DISPATCH_KEY=
